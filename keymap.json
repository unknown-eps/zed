// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },

  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "ctrl-shift-c": "editor::Copy"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-shift-c": "editor::Copy"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-p": ["terminal::SendKeystroke", "ctrl-p"]
    }
  },
  {
    "context": "Editor && mode == full && vim_mode == normal && !menu",
    "bindings": {
      "space w m": "workspace::ToggleZoom",
      "g s": null,
      "g s a": "vim::PushAddSurrounds",
      "g s r": ["vim::PushChangeSurrounds", {}],
      "g s d": "vim::PushDeleteSurrounds",
      // Native approximations of Flash jump and Flash Treesitter.
      "s": "vim::HelixJumpToWord",
      "shift-s": "vim::SelectLargerSyntaxNode",

      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "g shift-k": "editor::ShowSignatureHelp",
      "g r": "editor::FindAllReferences",
      "g r n": "editor::Rename",
      "g r a": "editor::ToggleCodeActions",
      "g r r": "editor::FindAllReferences",
      "g r i": "editor::GoToImplementation",
      "ctrl-up": "vim::ResizePaneUp",
      "ctrl-down": "vim::ResizePaneDown",
      "ctrl-left": "vim::ResizePaneLeft",
      "ctrl-right": "vim::ResizePaneRight",

      // Native pickers approximate LazyVim's file/buffer/project pickers.
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      // Approximation: this picker includes files, not a dedicated recent-files list.
      "space f r": "file_finder::Toggle",
      "space f b": "tab_switcher::Toggle",
      "space ,": "tab_switcher::Toggle",
      "space f p": "projects::OpenRecent",
      "space f n": "workspace::NewFile",
      "space f c": "zed::OpenSettingsFile",
      "space f t": "terminal_panel::ToggleFocus",
      "space f shift-t": "terminal_panel::ToggleFocus",
      "space /": "pane::DeploySearch",
      "space s g": "pane::DeploySearch",
      "space s shift-g": "pane::DeploySearch",
      "space s b": "buffer_search::Deploy",
      "space s s": "outline::Toggle",
      "space s shift-s": "project_symbols::Toggle",
      // Approximation of LazyVim's richer search/replace tool.
      "space s r": ["pane::DeploySearch", { "replace_enabled": true }],
      "space s k": "zed::OpenKeymap",
      "space s d": "diagnostics::Deploy",
      "space x x": "diagnostics::Deploy",

      // Keep LazyVim's alternate buffer; Space , opens the buffer picker.
      "space b b": "pane::AlternateFile",
      "space `": "pane::AlternateFile",
      "space b d": "pane::CloseActiveItem",
      "space b o": "pane::CloseOtherItems",
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "space c o": "editor::OrganizeImports",
      "space g g": "git_panel::ToggleFocus",
      "space g d": "git::Diff",
      "space g h p": "editor::ToggleSelectedDiffHunks",
      "space g h b": "editor::BlameHover",
      "space g h s": "git::ToggleStaged",
      "space g h r": "git::Restore",

      "space u w": "editor::ToggleSoftWrap",
      "space u l": "editor::ToggleLineNumbers",
      "space u shift-l": "editor::ToggleRelativeLineNumbers",
      "space u h": "editor::ToggleInlayHints",
      "space u g": "editor::ToggleIndentGuides",
      "space u b": "theme::ToggleMode",
      "space u shift-c": "theme_selector::Toggle",
      "space u shift-z": "workspace::ToggleZoom",
      "space -": "pane::SplitDown",
      "space w s": "pane::SplitDown",
      "space |": "pane::SplitRight",
      "space w v": "pane::SplitRight",
      "space w h": "workspace::ActivatePaneLeft",
      "space w j": "workspace::ActivatePaneDown",
      "space w k": "workspace::ActivatePaneUp",
      "space w l": "workspace::ActivatePaneRight",
      "space w d": "pane::CloseActiveItem",
      "space w q": "pane::CloseActiveItem"
    }
  },
  {
    "context": "Editor && mode == full && (vim_mode == normal || vim_mode == visual) && !menu",
    "bindings": {
      "space": null,
      "] e": ["editor::GoToDiagnostic", { "severity": "error" }],
      "[ e": ["editor::GoToPreviousDiagnostic", { "severity": "error" }],
      "] w": ["editor::GoToDiagnostic", { "severity": "warning" }],
      "[ w": ["editor::GoToPreviousDiagnostic", { "severity": "warning" }]
    }
  },
  {
    "context": "Editor && mode == full && vim_mode == visual && !menu",
    "bindings": {
      "g s": null,
      "g s a": "vim::PushAddSurrounds",
      // Approximation of Flash Treesitter; surrounds use gsa instead.
      "shift-s": "vim::SelectLargerSyntaxNode",
      "space c a": "editor::ToggleCodeActions",
      "space c f": "editor::FormatSelections",
      // Approximation of LazyVim's richer search/replace tool.
      "space s r": ["pane::DeploySearch", { "replace_enabled": true }]
    }
  },
  {
    "context": "Editor && mode == full && vim_mode == insert && !menu",
    "bindings": {
      "ctrl-s": "workspace::Save",
      "ctrl-k": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "Editor && mode == full && (vim_mode == normal || vim_mode == insert || vim_mode == visual) && !menu",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp"
    }
  },
]
